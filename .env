# PostgreSQL settings
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=postgres

# Apicurio settings
REGISTRY_DATASOURCE_URL=jdbc:postgresql://db/apicurio
REGISTRY_DATASOURCE_USERNAME=app
REGISTRY_DATASOURCE_PASSWORD=app

# Kafka Connect settings
CONNECT_BOOTSTRAP_SERVERS=b-1:9092
CONNECT_PLUGIN_PATH=/usr/share/java,/usr/share/confluent-hub-components
CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR=1
CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR=1
CONNECT_STATUS_STORAGE_REPLICATION_FACTOR=1
CONNECT_SCHEMA_NAME_ADJUSTMENT_MODE=avro
CONNECT_KEY_CONVERTER=io.confluent.connect.avro.AvroConverter
CONNECT_KEY_CONVERTER_SCHEMAS_ENABLE=true
CONNECT_KEY_CONVERTER_SCHEMA_REGISTRY_URL=http://s-1:8080/apis/ccompat/v7
CONNECT_VALUE_CONVERTER=io.confluent.connect.avro.AvroConverter
CONNECT_VALUE_CONVERTER_SCHEMAS_ENABLE=true
CONNECT_VALUE_CONVERTER_SCHEMA_REGISTRY_URL=http://s-1:8080/apis/ccompat/v7

# randb settings
RANDB_DATABASE_URL=postgres://app:app@db/app
RANDB_BATCH_SIZE=100
RANDB_INSERTS=60
RANDB_UPDATES=30
RANDB_PERIOD=0.1s
RANDB_DATABASE_MAX_CONNECTIONS=8
RANDB_CONCURRENCY=8
RANDB_INCLUDE='app_.*'
RANDB_LOG_LEVEL=INFO
RANDB_LOG_FORMAT=JSON

DS_LOG_LEVEL=debug
DS_KAFKA_CONSUMER_GROUP_ID=deltasink-0
DS_KAFKA_BROKER_URLS=localhost:19092
DS_KAFKA_TOPICS_REGEX=app.public.*
DS_SCHEMA_REGISTRY_URL=http://localhost:18000
DS_BUCKET=test
DS_ROOT=root
